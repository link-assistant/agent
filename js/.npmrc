# Fail the install when a dependency has install scripts that the
# `allowScripts` field in package.json does not cover. Without it npm only
# warns, and a stale pin (#337: node-pty@1.2.0-beta.15 while the lockfile
# resolves node-pty@1.1.0) silently skips the script. Re-approve after a
# dependency update with `npm install-scripts approve <package>`.
strict-allow-scripts=true
