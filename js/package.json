{
  "name": "@link-assistant/agent",
  "version": "0.27.1",
  "description": "A minimal, public domain AI CLI agent compatible with OpenCode's JSON interface. Bun-only runtime.",
  "main": "src/index.js",
  "type": "module",
  "bin": {
    "agent": "src/index.js"
  },
  "scripts": {
    "dev": "bun run src/index.js",
    "test": "bun test --timeout 30000 ./tests/*.js ./tests/*.ts",
    "test:integration": "bun test ./tests/integration/basic.js",
    "lint": "eslint . --max-warnings 0 && npm run lint:scripts",
    "lint:scripts": "cd ../scripts && eslint . --config ./eslint.config.mjs --max-warnings 0",
    "lint:fix": "eslint . --fix && cd ../scripts && eslint . --config ./eslint.config.mjs --fix",
    "format": "prettier --write . ../scripts",
    "format:check": "prettier --check . ../scripts",
    "check:file-size": "node ../scripts/check-file-size.mjs",
    "check:model-drift": "bun ../scripts/check-model-drift.mjs",
    "check": "npm run lint && npm run format:check && npm run check:file-size",
    "prepare": "node ../scripts/install-git-hooks.mjs",
    "changeset": "changeset",
    "changeset:version": "node ../scripts/changeset-version.mjs",
    "changeset:publish": "changeset publish",
    "changeset:status": "changeset status --since=origin/main"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/link-assistant/agent.git"
  },
  "keywords": [
    "ai",
    "cli",
    "agent",
    "opencode",
    "bun",
    "assistant",
    "json-interface"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src/",
    "package.json",
    "README.md",
    "LICENSE",
    "vendor/native-domexception/"
  ],
  "dependencies": {
    "@agentclientprotocol/sdk": "^2.4.0",
    "@ai-sdk/alibaba": "^2.0.84",
    "@ai-sdk/amazon-bedrock": "^5.0.134",
    "@ai-sdk/anthropic": "^4.0.98",
    "@ai-sdk/azure": "^4.0.118",
    "@ai-sdk/cerebras": "^3.0.86",
    "@ai-sdk/cohere": "^4.0.77",
    "@ai-sdk/deepinfra": "^3.0.86",
    "@ai-sdk/deepseek": "^3.0.80",
    "@ai-sdk/fireworks": "^3.0.89",
    "@ai-sdk/gateway": "^4.0.137",
    "@ai-sdk/google": "^4.0.113",
    "@ai-sdk/google-vertex": "^5.0.133",
    "@ai-sdk/groq": "^4.0.77",
    "@ai-sdk/mcp": "^2.0.92",
    "@ai-sdk/mistral": "^4.0.80",
    "@ai-sdk/openai": "^4.0.110",
    "@ai-sdk/openai-compatible": "^3.0.86",
    "@ai-sdk/perplexity": "^5.0.27",
    "@ai-sdk/provider": "^4.0.36",
    "@ai-sdk/togetherai": "^3.0.87",
    "@ai-sdk/xai": "^5.0.39",
    "@clack/prompts": "^1.8.1",
    "@hono/standard-validator": "^0.4.1",
    "@hono/zod-validator": "^0.9.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@octokit/graphql": "^9.0.5",
    "@octokit/rest": "^22.0.1",
    "@openauthjs/openauth": "^0.4.3",
    "@opencode-ai/sdk": "^1.19.5",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@opentui/core": "^0.8.2",
    "@opentui/solid": "^0.8.2",
    "@parcel/watcher": "^2.6.0",
    "@solid-primitives/event-bus": "^1.1.4",
    "@standard-community/standard-json": "^0.4.0",
    "@standard-community/standard-openapi": "^0.2.11",
    "@zip.js/zip.js": "^2.24.0",
    "ai": "^7.0.164",
    "chokidar": "^6.0.0",
    "clipboardy": "^5.3.2",
    "command-stream": "^2.6.0",
    "decimal.js": "^10.6.0",
    "diff": "^9.0.0",
    "fuzzysort": "^4.0.2",
    "glob": "^14.0.4",
    "google-auth-library": "^11.3.3",
    "gpt-tokenizer": "^4.1.0",
    "gray-matter": "^4.0.3",
    "hono": "^4.13.16",
    "hono-openapi": "^1.5.0",
    "ignore": "^7.0.14",
    "jsonc-parser": "^3.3.1",
    "lino-arguments": "^0.4.1",
    "lino-objects-codec": "^0.9.5",
    "log-lazy": "^1.0.4",
    "minimatch": "^11.0.5",
    "remeda": "^2.58.0",
    "solid-js": "^1.9.18",
    "strip-ansi": "^7.2.0",
    "test-anywhere": "^0.9.1",
    "tree-sitter-bash": "^0.25.1",
    "turndown": "^7.2.5",
    "ulid": "^3.0.2",
    "vscode-jsonrpc": "^10.0.0",
    "vscode-languageserver-types": "^3.18.5",
    "web-tree-sitter": "0.25.10",
    "xdg-basedir": "^5.1.0",
    "yargs": "^18.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-promise": "^7.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10"
  },
  "lint-staged": {
    "*.{js,mjs,cjs}": [
      "eslint --fix --max-warnings 0",
      "prettier --write",
      "prettier --check"
    ],
    "*.md": [
      "prettier --write",
      "prettier --check"
    ]
  },
  "license": "Unlicense",
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "tree-sitter-bash@0.25.1": true,
    "node-pty@1.1.0": true
  },
  "overrides": {
    "undici": "^7.16.0",
    "node-domexception": "file:vendor/native-domexception",
    "glob": "^14.0.4",
    "minimatch": "^11.0.5"
  },
  "dependencyPins": {
    "web-tree-sitter": "https://github.com/anomalyco/opentui/issues/1550"
  }
}
