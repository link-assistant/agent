--- template/.github/zizmor.yml
+++ .github/zizmor.yml
@@ -1,18 +1,20 @@
-# zizmor configuration for the workflow security audit run by
-# `.github/workflows/workflows.yml`.
+# zizmor configuration — https://docs.zizmor.sh/configuration/
 #
-# Blanket policy: third-party actions must be pinned to a commit hash, because
-# a mutable tag or branch of a repository we do not control is arbitrary code
-# execution in any job that holds credentials. Namespaces we do trust to keep
-# their release tags immutable are allowed to stay on a readable ref.
+# Added for issue #301: nothing linted the workflow files themselves, so a
+# `${{ github.base_ref }}` template injection in rust.yml and eight unpinned
+# third-party actions sat in the pipeline unnoticed.
 rules:
   unpinned-uses:
     config:
       policies:
+        # First-party publishers whose release tags are the reference we want
+        # to read at a glance. Everything else must be pinned to a full commit
+        # hash so a moved tag cannot silently change what CI executes.
         actions/*: ref-pin
         github/*: ref-pin
         docker/*: ref-pin
         astral-sh/*: ref-pin
         lycheeverse/*: ref-pin
         zizmorcore/*: ref-pin
+        changesets/*: ref-pin
         '*': hash-pin
