-fetch_with_retry
-
-BASE_SHA="$(git rev-parse FETCH_HEAD)"
-HEAD_SHA="$(git rev-parse HEAD)"
-echo "Base: ${BASE_REF} (${BASE_SHA})"
-echo "Head: ${HEAD_SHA}"
