--- template/.github/zizmor.yml
+++ .github/zizmor.yml
@@ -1,11 +1,15 @@
 # zizmor configuration — https://docs.zizmor.sh/configuration/
+#
+# Added for issue #301: nothing linted the workflow files themselves, so a
+# `${{ github.base_ref }}` template injection in rust.yml and eight unpinned
+# third-party actions sat in the pipeline unnoticed.
 rules:
   unpinned-uses:
     config:
       policies:
-        # These publishers are trusted at tag granularity: their release tags
-        # are the reference this template is meant to read at a glance.
-        # Everything else must be pinned to a full commit hash.
+        # First-party publishers whose release tags are the reference we want
+        # to read at a glance. Everything else must be pinned to a full commit
+        # hash so a moved tag cannot silently change what CI executes.
         actions/*: ref-pin
         github/*: ref-pin
         docker/*: ref-pin
@@ -14,20 +18,3 @@
         zizmorcore/*: ref-pin
         changesets/*: ref-pin
         '*': hash-pin
-  # zizmor >= 1.30.0 asks for GitHub's `uses: $/...` self-repository syntax
-  # (shipped 2026-07-30) instead of `uses: ./...`. actionlint does not parse
-  # `$/` yet -- v1.7.12 is the newest release and support is still open
-  # upstream (rhysd/actionlint#711, rhysd/actionlint#732) -- so the two jobs
-  # in workflows.yml contradict each other: satisfying zizmor makes
-  # actionlint fail with "invalid format because ref is missing".
-  #
-  # Drop this block once actionlint understands `$/`.
-  self-repository:
-    ignore:
-      - release.yml
-      - example-app.yml
-      - action.yml
-      - javascript-first-example.yml
-      - links.yml
-      - security.yml
-      - workflows.yml
